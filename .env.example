# ==========================================================
# SMARTROAD AI — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and provide your credentials
# ==========================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=development
PORT=8501

# 2. SUPABASE POSTGRESQL & STORAGE (FREE TIER)
# Leave blank to automatically use local SQLite (database/smartroad.db)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-public-key
SUPABASE_BUCKET_NAME=smartroad-images

# 3. AI MODEL PATH
MODEL_PATH=models/pothole_best.pt

# 4. PRIORITY ENGINE DEFAULT WEIGHTS
WEIGHT_SEVERITY=0.40
WEIGHT_TRAFFIC=0.30
WEIGHT_REPEAT=0.20
WEIGHT_SAFETY=0.10
DUPLICATE_RADIUS_METERS=50.0
